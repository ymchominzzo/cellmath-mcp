# CellMath MCP connection settings.
# Copy this file to .env and replace the placeholders with your own values.
# .env is git-ignored and never read by the bridge automatically.

# Streamable HTTP endpoint of your CellMath MCP server.
CELLMATH_MCP_URL=https://<your-mcp-endpoint>/api/mcp

# Your CellMath API key. Sent as "Authorization: Bearer <key>".
# Keep it secret. Never commit it, paste it in an issue, or share it in a screenshot.
CELLMATH_API_KEY=sk_live_<your_api_key>

# Optional: per-request timeout in milliseconds (default 120000).
# CELLMATH_MCP_TIMEOUT_MS=120000
